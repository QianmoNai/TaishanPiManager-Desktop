{
  "schema_version": 1,
  "id": "com.taishanpi.import-test",
  "name": "插件导入测试",
  "version": "1.0.0",
  "author": "TaishanPi Manager",
  "description": "只读测试插件：验证第三方插件包导入、独立页面、状态卡片和后台轮询。",
  "actions": [
    {"title": "查询设备信息", "script": "scripts/info.sh"}
  ],
  "page": {
    "title": "插件导入测试",
    "cards": [
      {"id": "uptime", "title": "运行时间"},
      {"id": "load", "title": "系统负载"},
      {"id": "storage", "title": "userdata 使用率"}
    ],
    "poll": {
      "script": "scripts/status.sh",
      "interval_ms": 5000,
      "format": "json"
    }
  }
}
